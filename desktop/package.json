{
  "name": "yavaka-desktop",
  "version": "1.0.0",
  "private": true,
  "author": "YaVaKa",
  "description": "YaVaKa desktop shell — runs the Flask app locally and wraps it in a native window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.zw.yavaka.desktop",
    "productName": "YaVaKa",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
