{
  "name": "Vaka — Build from anywhere",
  "short_name": "Vaka",
  "description": "Track your Zimbabwe construction project end to end: stages, funding, receipts, agreements and WhatsApp updates.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
