# Postgres connection string. When set it wins over DATABASE_FILE.
# Example: postgresql://vaka:secret@localhost:5432/vaka
# DATABASE_URL=

# Local SQLite database and uploads live here (git-ignored).
# DATABASE_FILE=instance/vaka.db
# UPLOAD_DIR=uploads

# Session signing key. If unset, a random key is generated once and stored in
# instance/secret.key. Set this explicitly in production.
SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=0

# ---- Observability ----
# 1 = JSON log lines (for a log drain); 0 = plain text.
LOG_JSON=0
LOG_LEVEL=INFO
# Log queries slower than this many milliseconds (0 disables).
SLOW_QUERY_MS=150
# Optional collector: unhandled exceptions are POSTed here as JSON.
ERROR_WEBHOOK_URL=

# Seed the demo workspace (client@vaka.co.zw / manager@vaka.co.zw / Vaka2026!)
SEED_DEMO=true

# ---- WhatsApp Cloud API (Meta) ----
# Leave blank to run the simulator: messages are stored, never sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required: the webhook rejects every request until this is set.
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: enables X-Hub-Signature-256 verification of webhooks.
WHATSAPP_APP_SECRET=

# Shared secret for POST /api/whatsapp/digest. Empty = endpoint returns 403.
DIGEST_TOKEN=

# ---- Email (SMTP) ----
# Used for password resets, client/manager update emails and team invites.
# Leave SMTP_HOST blank to disable email; the app then falls back to
# in-app notifications and says so on screen.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Paste the 16 characters with no spaces into SMTP_PASSWORD. Your normal
# Google password will NOT work. Limit is ~500 recipients a day.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=1
#   SMTP_USE_SSL=0
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#   SMTP_FROM_EMAIL=YaVaKa <you@gmail.com>
#
# Port 465 (implicit TLS) also works: SMTP_PORT=465, SMTP_USE_SSL=1,
# SMTP_USE_TLS=0. Gmail rewrites the From address to the account you
# authenticated as unless it is registered under "Send mail as".
#
# Verify a config without touching the app:
#   python -m tools.check_email you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be set or email is treated as unconfigured.
SMTP_FROM_EMAIL=
