# Postgres connection string. When set it wins over DATABASE_FILE.
# Example: postgresql://vaka:secret@localhost:5432/vaka
# DATABASE_URL=

# Local SQLite database and uploads live here (git-ignored).
# DATABASE_FILE=instance/vaka.db
# UPLOAD_DIR=uploads

# Session signing key. If unset, a random key is generated once and stored in
# instance/secret.key. Set this explicitly in production.
SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=0

# ---- Observability ----
# 1 = JSON log lines (for a log drain); 0 = plain text.
LOG_JSON=0
LOG_LEVEL=INFO
# Log queries slower than this many milliseconds (0 disables).
SLOW_QUERY_MS=150
# Optional collector: unhandled exceptions are POSTed here as JSON.
ERROR_WEBHOOK_URL=

# Seed the demo workspace (client@vaka.co.zw / manager@vaka.co.zw / Vaka2026!)
SEED_DEMO=true

# ---- WhatsApp Cloud API (Meta) ----
# Leave blank to run the simulator: messages are stored, never sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required: the webhook rejects every request until this is set.
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: enables X-Hub-Signature-256 verification of webhooks.
WHATSAPP_APP_SECRET=

# Shared secret for POST /api/whatsapp/digest. Empty = endpoint returns 403.
DIGEST_TOKEN=

# ---- Email ----
# Used for password resets, client/manager update emails and team invites.
# Leave everything blank to disable email; the app then says so on screen
# instead of silently dropping messages.
#
# Pick ONE of the two routes below.
#
# Route A (recommended): an HTTPS email API. Use this on Render Free, which
# blocks outbound SMTP on ports 25, 465 and 587, so no SMTP setting can work
# there. Setting any key below switches the app off SMTP automatically.
#   Brevo    - 300/day free, verifies a single sender address (no domain).
#              Get the key at https://app.brevo.com/settings/keys/api
#   Resend   - 100/day free, needs a verified domain to mail arbitrary people.
#   SendGrid - 100/day free, verifies a single sender.
# Optional: force one provider with EMAIL_API_PROVIDER=brevo|resend|sendgrid.
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_API_PROVIDER=
#
# Route B: SMTP. Works on a paid Render instance or any host that allows
# outbound mail. For Gmail you must use an App Password, not your real
# password - see README "Sending email with Gmail".
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=1
#   SMTP_USE_SSL=0
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
# Port 465 (implicit TLS): SMTP_PORT=465, SMTP_USE_SSL=1, SMTP_USE_TLS=0.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
#
# The sender identity, used by both routes. Either `hello@yavaka.co.zw` or
# `YaVaKa <hello@yavaka.co.zw>`. Required: without it email stays disabled.
# SMTP_FROM_EMAIL is accepted as an older alias.
EMAIL_FROM=
#
# Verify a setup without touching the app:
#   python -m tools.check_email you@example.com
#   python -m tools.check_email you@example.com --dry-run
