# Local SQLite database and uploads live here (git-ignored).
# DATABASE_FILE=instance/vaka.db
# UPLOAD_DIR=uploads

# Session signing key. If unset, a random key is generated once and stored in
# instance/secret.key. Set this explicitly in production.
SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=0

# Seed the demo workspace (client@vaka.co.zw / manager@vaka.co.zw / Vaka2026!)
SEED_DEMO=true

# ---- WhatsApp Cloud API (Meta) ----
# Leave blank to run the simulator: messages are stored, never sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required: the webhook rejects every request until this is set.
WHATSAPP_VERIFY_TOKEN=
# Strongly recommended: enables X-Hub-Signature-256 verification of webhooks.
WHATSAPP_APP_SECRET=

# Shared secret for POST /api/whatsapp/digest. Empty = endpoint returns 403.
DIGEST_TOKEN=
