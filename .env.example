# Local SQLite database
DATABASE_URL="file:./dev.db"

# Signing secret for session cookies (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"

# Public URL of the app, used in messages and manifests
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- WhatsApp Cloud API (Meta) ----
# Leave blank to run in simulator mode (messages are stored, not sent)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="vaka-verify-token"
WHATSAPP_APP_SECRET=""

# Where uploaded receipts/documents are stored (defaults to ./uploads)
UPLOAD_DIR="./uploads"
